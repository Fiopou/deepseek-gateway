# Скопируй в .env и впиши свои значения.
# Ключ burngate (одним из двух способов). Несколько ключей - через запятую.
BURNGATE_API_KEY=gk_ВАШ_КЛЮЧ
# BURNGATE_API_KEYS=gk_ключ1,gk_ключ2

# Необязательное:
# Модель по умолчанию: deepseek (по умолч.), gemini или полный id burngate:
# BURNGATE_MODEL=gemini
# GATEWAY_PORT=8787
# GATEWAY_TOKEN=мой_пароль
# GATEWAY_MAX_CONTEXT=150000
# BURNGATE_EFFORT=max   # форсится для всех запросов шлюза
# BURNGATE_BASE=https://burngate.space/api/v1
# GATEWAY_PROBE=0