# Скопируй в .env и впиши свои значения.
# Ключ burngate (одним из двух способов). Несколько ключей - через запятую.
BURNGATE_API_KEY=gk_ВАШ_КЛЮЧ
# BURNGATE_API_KEYS=gk_ключ1,gk_ключ2

# Необязательное:
# Модель по умолчанию: deepseek (по умолч.), gemini или полный id burngate:
# BURNGATE_MODEL=gemini
# GATEWAY_PORT=8787
# GATEWAY_TOKEN=мой_пароль
# GATEWAY_MAX_CONTEXT=150000
# GATEWAY_RATE_COOLDOWN=20
# BURNGATE_EFFORT=max   # форсится для всех запросов шлюза
# BURNGATE_BASE=https://burngate.space/api/v1
# GATEWAY_PROBE=0
# GATEWAY_EXTRA_SYSTEM_FILE=jailbreak.txt   # текст дописывается в system каждого запроса
# GATEWAY_EXTRA_SYSTEM=свой текст, дописать в system каждого запроса
# GATEWAY_PREFILL_FILE=prefill.txt          # стартовый assistant-ход (deepseek ок, gemini отбивает 500)
# GATEWAY_PREFILL=свой текст стартового assistant-хода
# GATEWAY_EXTRA_SYSTEM_MODELS=deepseek      # к каким моделям применять extra/prefill (пусто = ко всем)